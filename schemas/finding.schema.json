{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"ScubaTank finding design contract",
 "type":"object","additionalProperties":false,
 "required":["schema_version","finding_id","check_id","status","severity","confidence","coverage","message","evidence_refs","affected_entity_ids","missing_evidence","mappings"],
 "properties":{
  "schema_version":{"const":"0.1.0"},
  "finding_id":{"type":"string","minLength":1},
  "check_id":{"type":"string","pattern":"^ST\\.(CORR|POST)\\.[A-Z]+\\.[0-9]{3}$"},
  "status":{"enum":["Pass","Fail","Unknown","NotApplicable","Error","NotImplemented","ReviewRequired"]},
  "severity":{"enum":["Low","Medium","High","Critical"]},
  "confidence":{"enum":["Low","Medium","High","Unknown"]},
  "coverage":{"enum":["complete","partial","unknown"]},
  "message":{"type":"string","minLength":1},
  "evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
  "affected_entity_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
  "missing_evidence":{"type":"array","items":{"type":"string","minLength":1}},
  "mappings":{
   "type":"object","additionalProperties":false,"required":["status","nist","attack"],
   "properties":{
    "status":{"enum":["project-proposed","independently-reviewed"]},
    "nist":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z]{2}-[0-9]+(\\([0-9]+\\))?$"}},
    "attack":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^T[0-9]{4}(\\.[0-9]{3})?$"}}
   }
  }
 },
 "allOf":[
  {"if":{"properties":{"status":{"const":"Fail"}}},"then":{"properties":{"evidence_refs":{"minItems":1},"affected_entity_ids":{"minItems":1},"missing_evidence":{"maxItems":0}}}},
  {"if":{"properties":{"status":{"const":"Unknown"}}},"then":{"properties":{"missing_evidence":{"minItems":1}}}},
  {"if":{"properties":{"status":{"const":"Pass"}}},"then":{"properties":{"coverage":{"const":"complete"},"evidence_refs":{"minItems":1},"missing_evidence":{"maxItems":0}}}}
 ]
}
